{
  "name": "@papyrus/cli",
  "version": "2.0.0-beta.12",
  "description": "Papyrus Desktop TypeScript API and MCP command-line client",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "papyrus": "dist/cli.js",
    "papyrus-cli": "dist/cli.js"
  },
  "files": [
    "dist/**/*",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "node dist/cli.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js --runInBand",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage --runInBand",
    "test:runtime": "node scripts/runtime-smoke.mjs",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\"",
    "lint:fix": "eslint \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" package.json tsconfig.json tsconfig.test.json jest.config.js eslint.config.js README.md",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\" \"scripts/**/*.mjs\" package.json tsconfig.json tsconfig.test.json jest.config.js eslint.config.js README.md",
    "typecheck": "tsc --noEmit",
    "quality": "npm run typecheck && npm run lint && npm run format:check && npm run test",
    "prepublishOnly": "npm run quality && npm run build",
    "clean": "node -e \"const fs=require('node:fs'); for(const p of ['dist','coverage']) fs.rmSync(p,{recursive:true,force:true})\""
  },
  "keywords": [
    "papyrus",
    "srs",
    "spaced-repetition",
    "flashcards",
    "learning",
    "cli",
    "study"
  ],
  "author": "PapyrusOR",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/PapyrusOR/Papyrus_CLI.git"
  },
  "bugs": {
    "url": "https://github.com/PapyrusOR/Papyrus_CLI/issues"
  },
  "homepage": "https://github.com/PapyrusOR/Papyrus_CLI#readme",
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {},
  "devDependencies": {
    "@jest/globals": "^29.7.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.14.0",
    "@typescript-eslint/eslint-plugin": "^8.29.0",
    "@typescript-eslint/parser": "^8.29.0",
    "eslint": "^9.24.0",
    "globals": "^17.4.0",
    "jest": "^29.7.0",
    "prettier": "^3.5.3",
    "ts-jest": "^29.3.1",
    "typescript": "^5.8.3"
  }
}
